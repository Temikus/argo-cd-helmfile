{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "schedule:nonOfficeHours"
  ],
  "timezone": "Australia/Sydney",
  "forkProcessing": "enabled",
  "labels": [
    "dependencies"
  ],
  "rebaseWhen": "behind-base-branch",
  "automerge": false,
  "prConcurrentLimit": 5,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Single-value tool ARGs (datasource=github-releases; verified at build time against an upstream checksum file). Scoped to github-releases so it does not also match the github-tags plugin block below.",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s*\\nARG \\w+_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Helm plugins: ARG version plus a paired commit-SHA pin, kept in sync via digest lookup",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-tags) depName=(?<depName>\\S+)\\s*\\nARG \\w+_VERSION=\"(?<currentValue>[^\"]+)\"\\s*\\nARG \\w+_SHA=\"(?<currentDigest>[0-9a-f]+)\""
      ],
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Pinned per-arch SHA256 of a release asset (age, yq). github-release-attachments finds the asset the current hash belongs to and hashes the same asset in the new release. Each pin carries its own digestVersion so no two deps edit the same line; the shared depName puts them in the version bump's branch.",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>github-release-attachments) depName=(?<depName>\\S+) digestVersion=(?<currentValue>\\S+)\\s*\\nARG \\w+_SHA256_\\w+=\"(?<currentDigest>[0-9a-f]{64})\""
      ],
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Stay on the helm v3 line (ARG is HELM3_VERSION; helmfile drives helm3, v4 is a breaking major)",
      "matchDepNames": [
        "helm/helm"
      ],
      "allowedVersions": "<4"
    },
    {
      "description": "Group the three helm plugins into a single PR",
      "matchDepNames": [
        "databus23/helm-diff",
        "aslafy-z/helm-git",
        "jkroepke/helm-secrets"
      ],
      "groupName": "helm plugins"
    }
  ]
}
